{
  "name": "@yeschef/error-intake",
  "version": "0.1.0",
  "description": "Collect server and browser errors in a MySQL database shared with YesChef.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.ts",
        "default": "./dist/nestjs.js"
      },
      "require": {
        "types": "./dist/nestjs.d.cts",
        "default": "./dist/nestjs.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10 <13",
    "@nestjs/core": ">=10 <13",
    "express": ">=4",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "express": "^5.2.1",
    "jsdom": "^30.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanfour/yeschef.git",
    "directory": "packages/error-intake"
  },
  "homepage": "https://github.com/hanfour/yeschef/tree/main/packages/error-intake#readme",
  "bugs": {
    "url": "https://github.com/hanfour/yeschef/issues"
  }
}
